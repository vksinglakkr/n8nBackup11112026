    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ─────────────────────────────────────────────\n// STEP 1: Map your Google Form columns to variables\n// Change the column names below to match YOUR sheet\n// ─────────────────────────────────────────────\nconst row = $input.item.json;\n\nconst name          = row['Name'] || row['नाम'] || row['Full Name'] || '';\nconst phone         = row['Phone'] || row['Mobile'] || row['WhatsApp Number'] || row['फोन'] || '';\nconst email         = row['Email'] || row['Email Address'] || row['ईमेल'] || '';\nconst address       = row['Address'] || row['Village'] || row['पता'] || '';\nconst category      = row['Category'] || row['Complaint Category'] || row['शिकायत का प्रकार'] || 'Other';\nconst complaintText = row['Complaint'] || row['Complaint Text'] || row['शिकायत'] || row['Description'] || '';\nconst language      = row['Language'] || row['Preferred Language'] || 'Hindi';\nconst timestamp     = row['Timestamp'] || new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });\n\n// Format phone for Twilio\nlet phone_clean = phone.toString().replace(/\\s|-/g, '');\nif (!phone_clean.startsWith('+')) phone_clean = '+91' + phone_clean;\n\n// Generate reference number\nconst refNumber = '#KKR' + Date.now().toString().slice(-6);\n\nreturn {\n  json: {\n    name, phone, phone_clean, email, address,\n    category, complaintText, language,\n    timestamp, refNumber,\n    citizenWhatsApp: 'whatsapp:' + phone_clean\n  }\n};"
      },
      "id": "d9bb2451-b94f-4c9a-a901-79cbecd5c115",
      "name": "Map Form Columns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"max_tokens\": 600,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a government complaint assistant for District Administration Kurukshetra, Haryana. Do two things:\\n\\n1. Rewrite the citizen complaint in formal, clear language suitable for government records. Keep all facts. Respond in the SAME language (Hindi/English/Punjabi). Start with Respected Sir/Madam or आदरणीय महोदय. End with citizen name and address. Max 150 words.\\n\\n2. After the improved text add these lines EXACTLY:\\nDEPARTMENT: [PENSION/AADHAAR/PPP/RATION/REVENUE/CRED/OTHERS]\\nPRIORITY: [High/Medium/Low]\\nSUMMARY: [one line]\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Name: {{ $json.name }}\\nAddress: {{ $json.address }}\\nCategory: {{ $json.category }}\\nLanguage: {{ $json.language }}\\nComplaint:\\n{{ $json.complaintText }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "d23f676c-6d89-48e4-8f30-1d5388bdb4ee",
      "name": "AI Improve Complaint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -672,
        144
      ],
      "credentials": {
        "groqApi": {
          "id": "SVypylwZhqG2a8gE",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const aiText = $input.item.json.choices[0].message.content;\nconst prev   = $('Map Form Columns').item.json;\n\n// Extract metadata from AI response\nconst deptMatch     = aiText.match(/DEPARTMENT:\\s*(\\w+)/i);\nconst priorityMatch = aiText.match(/PRIORITY:\\s*(\\w+)/i);\nconst summaryMatch  = aiText.match(/SUMMARY:\\s*(.+)/i);\n\nconst dept     = deptMatch     ? deptMatch[1].toUpperCase().trim()  : 'OTHERS';\nconst priority = priorityMatch ? priorityMatch[1].trim()            : 'Medium';\nconst summary  = summaryMatch  ? summaryMatch[1].trim()             : prev.complaintText.slice(0, 100);\n\n// Clean improved text — strip the metadata lines\nconst improvedText = aiText\n  .replace(/DEPARTMENT:.*$/mi, '')\n  .replace(/PRIORITY:.*$/mi,   '')\n  .replace(/SUMMARY:.*$/mi,    '')\n  .trim();\n\n// Department → officer routing\nconst routingMap = {\n  PENSION:  { email: 'vksinglakkr+groq5@gmail.com', label: 'DSWO (Pension)'   },\n  AADHAAR:  { email: 'vksinglakkr+groq4@gmail.com', label: 'ADC (Aadhaar)'    },\n  PPP:      { email: 'vksinglakkr+groq1@gmail.com', label: 'ADC (PPP)'        },\n  RATION:   { email: 'vksinglakkr+groq3@gmail.com', label: 'DFSC (Ration)'    },\n  REVENUE:  { email: 'vksinglakkr+groq2@gmail.com', label: 'DRO (Revenue)'    },\n  CRED:     { email: 'vksinglakkr+groq6@gmail.com', label: 'ADC (CRED)'       },\n  OTHERS:   { email: 'vksinglakkr+groq7@gmail.com', label: 'DC Office'        }\n};\n\nconst route = routingMap[dept] || routingMap.OTHERS;\n\nreturn {\n  json: {\n    ...prev,\n    improvedText,\n    department:   dept,\n    priority,\n    summary,\n    officerEmail: route.email,\n    officerLabel: route.label\n  }\n};"
      },
