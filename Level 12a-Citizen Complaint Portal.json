        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto\">\n  <div style=\"background:#b71c1c;padding:20px;border-radius:8px 8px 0 0\">\n    <h2 style=\"color:white;margin:0\">District Administration Kurukshetra</h2>\n    <p style=\"color:#ffcdd2;margin:4px 0 0\">Complaint — {{ $json.officerLabel }}</p>\n  </div>\n  <div style=\"background:#fff8e1;border:1px solid #ffe082;padding:14px\">\n    <strong style=\"color:#e65100\">ACTION REQUIRED — {{ $json.priority }} Priority | {{ $json.department }}</strong>\n  </div>\n  <div style=\"background:#fff;padding:24px;border:1px solid #e0e0e0\">\n    <table style=\"width:100%;font-size:14px;border-collapse:collapse;margin-bottom:20px\">\n      <tr style=\"background:#f5f5f5\"><td style=\"padding:8px 12px;font-weight:bold;width:130px\">Reference</td><td style=\"padding:8px 12px;color:#1a237e;font-weight:bold\">{{ $json.refNumber }}</td></tr>\n      <tr><td style=\"padding:8px 12px;font-weight:bold\">Received</td><td style=\"padding:8px 12px\">{{ $json.timestamp }}</td></tr>\n      <tr style=\"background:#f5f5f5\"><td style=\"padding:8px 12px;font-weight:bold\">Citizen</td><td style=\"padding:8px 12px\">{{ $json.name }}</td></tr>\n      <tr><td style=\"padding:8px 12px;font-weight:bold\">Phone</td><td style=\"padding:8px 12px\">{{ $json.phone }}</td></tr>\n      <tr style=\"background:#f5f5f5\"><td style=\"padding:8px 12px;font-weight:bold\">Email</td><td style=\"padding:8px 12px\">{{ $json.email }}</td></tr>\n      <tr><td style=\"padding:8px 12px;font-weight:bold\">Address</td><td style=\"padding:8px 12px\">{{ $json.address }}</td></tr>\n      <tr style=\"background:#f5f5f5\"><td style=\"padding:8px 12px;font-weight:bold\">Category</td><td style=\"padding:8px 12px\">{{ $json.category }}</td></tr>\n      <tr><td style=\"padding:8px 12px;font-weight:bold\">Priority</td><td style=\"padding:8px 12px\">{{ $json.priority }}</td></tr>\n    </table>\n    <div style=\"background:#e8f5e9;border-left:4px solid #2e7d32;padding:16px;margin-bottom:16px;border-radius:0 8px 8px 0\">\n      <strong style=\"color:#1b5e20\">✨ AI Improved Complaint (for official use):</strong><br/><br/>\n      <p style=\"font-size:13px;color:#333;white-space:pre-wrap\">{{ $json.improvedText }}</p>\n    </div>\n    <div style=\"background:#fafafa;border:1px solid #e0e0e0;padding:16px;border-radius:8px\">\n      <strong>Original (as submitted by citizen):</strong><br/><br/>\n      <p style=\"font-size:13px;color:#777;white-space:pre-wrap\">{{ $json.complaintText }}</p>\n    </div>\n  </div>\n  <div style=\"background:#f5f5f5;padding:12px;text-align:center;border-radius:0 0 8px 8px\">\n    <p style=\"color:#999;font-size:12px;margin:0\">Automated Complaint System | District Administration Kurukshetra</p>\n  </div>\n</div>",
