        "subject": "=✅ Complaint Registered {{ $json.refNumber }} | DC Kurukshetra",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto\">\n  <div style=\"background:#1a237e;padding:20px;border-radius:8px 8px 0 0\">\n    <h2 style=\"color:white;margin:0\">District Administration Kurukshetra</h2>\n    <p style=\"color:#c5cae9;margin:4px 0 0\">नागरिक शिकायत पोर्टल | Citizen Complaint Portal</p>\n  </div>\n  <div style=\"background:#e8f5e9;border:1px solid #a5d6a7;padding:14px\">\n    <strong style=\"color:#2e7d32\">✅ Your complaint has been successfully registered!</strong>\n  </div>\n  <div style=\"background:#fff;padding:24px;border:1px solid #e0e0e0\">\n    <p>Dear <strong>{{ $json.name }}</strong>,</p>\n    <p>Your complaint has been received and forwarded to <strong>{{ $json.officerLabel }}</strong>.</p>\n    <table style=\"width:100%;font-size:14px;border-collapse:collapse;margin:16px 0\">\n      <tr style=\"background:#e8eaf6\"><td style=\"padding:10px;font-weight:bold\">Reference No.</td><td style=\"padding:10px;color:#1a237e;font-weight:bold\">{{ $json.refNumber }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">Category</td><td style=\"padding:10px\">{{ $json.category }}</td></tr>\n      <tr style=\"background:#f5f5f5\"><td style=\"padding:10px;font-weight:bold\">Forwarded To</td><td style=\"padding:10px\">{{ $json.officerLabel }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">Priority</td><td style=\"padding:10px\">{{ $json.priority }}</td></tr>\n      <tr style=\"background:#f5f5f5\"><td style=\"padding:10px;font-weight:bold\">Date & Time</td><td style=\"padding:10px\">{{ $json.timestamp }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">Status</td><td style=\"padding:10px\"><span style=\"background:#fff3e0;color:#e65100;padding:2px 10px;border-radius:12px\">Forwarded for Action</span></td></tr>\n    </table>\n    <p style=\"color:#666;font-size:12px\">You will also receive a WhatsApp confirmation on {{ $json.phone }}. Please keep your Reference Number for follow-up.</p>\n    <p>Jai Hind | जय हिन्द 🇮🇳</p>\n  </div>\n  <div style=\"background:#f5f5f5;padding:12px;text-align:center;border-radius:0 0 8px 8px\">\n    <p style=\"color:#999;font-size:12px;margin:0\">District Administration Kurukshetra, Haryana</p>\n  </div>\n</div>",
        "options": {}
