    {
      "parameters": {
        "jsCode": "let answer = '';\n\nif ($json.answer) {\n  answer = $json.answer;\n} else if ($json.response) {\n  answer = $json.response;\n} else if ($json.text) {\n  answer = $json.text;\n} else if ($json.message) {\n  answer = $json.message;\n} else if ($json.body && $json.body.answer) {\n  answer = $json.body.answer;\n} else {\n  answer = JSON.stringify($json).substring(0, 4000);\n}\n\nanswer = String(answer).replace(/<[^>]*>/g, '').replace(/\\n\\n\\n+/g, '\\n\\n').substring(0, 4000);\n\nconst from = $('Detect Intent').item.json.from;\n\nreturn [{\n  json: {\n    answer: answer,\n    from: from\n  }\n}];"
      },
