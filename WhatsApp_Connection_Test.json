    {
      "parameters": {
        "jsCode": "// Safely get user message\nconst userMessage = ($json.userMessage || '').toLowerCase().trim();\n\n// Handle empty or missing messages\nif (!userMessage) {\n  return [{\n    json: {\n      userMessage: '',\n      from: $json.from,\n      isWelcome: false,\n      skip: true\n    }\n  }];\n}\n\n// Detect welcome keywords\nconst welcomeKeywords = [\n  'hi', 'hello', 'hey', 'start', \n  'नमस्ते', 'namaste', 'namaskar',\n  'help', 'menu', 'info'\n];\n\nconst isWelcome = welcomeKeywords.some(keyword => userMessage === keyword);\n\nreturn [{\n  json: {\n    userMessage: $json.userMessage,\n    from: $json.from,\n    isWelcome: isWelcome,\n    skip: false\n  }\n}];"
      },
