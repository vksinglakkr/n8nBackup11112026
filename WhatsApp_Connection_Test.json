      "parameters": {
        "jsCode": "const userMessage = $json.userMessage.toLowerCase();\n\nconst gitaKeywords = [\n  'gita', 'geeta', 'गीता',\n  'krishna', 'कृष्ण',\n  'arjun', 'अर्जुन',\n  'dharma', 'धर्म',\n  'karma', 'कर्म',\n  'bhagavad', 'भगवद',\n  'chapter', 'shlok', 'श्लोक',\n  'verse', 'mahabharat', 'महाभारत',\n  'spiritual', 'philosophy',\n  'moksha', 'मोक्ष',\n  'yoga', 'योग',\n  'atma', 'आत्मा'\n];\n\nconst isGitaQuestion = gitaKeywords.some(keyword => userMessage.includes(keyword));\n\nreturn [{\n  json: {\n    userMessage: $json.userMessage,\n    from: $json.from,\n    isGitaQuestion: isGitaQuestion,\n    route: isGitaQuestion ? 'gita' : 'tourism'\n  }\n}];"
      },
