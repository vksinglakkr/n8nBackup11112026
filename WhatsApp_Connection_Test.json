    {
      "parameters": {
        "jsCode": "const data = $input.item.json.body;\n\n// Check if this is a valid entry\nif (!data.entry || !data.entry[0].changes) {\n  return [{ json: { skip: true } }];\n}\n\nconst change = data.entry[0].changes[0].value;\n\n// FILTER OUT STATUS UPDATES (read, delivered, sent)\nif (change.statuses) {\n  console.log('⏭️ Skipping status update');\n  return [{ json: { skip: true } }];\n}\n\n// FILTER OUT non-message webhooks\nif (!change.messages || !change.messages[0]) {\n  console.log('⏭️ No messages in webhook');\n  return [{ json: { skip: true } }];\n}\n\nconst message = change.messages[0];\n\n// Only process text messages\nif (!message.text || !message.text.body) {\n  console.log('⏭️ Not a text message');\n  return [{ json: { skip: true } }];\n}\n\nconst userText = message.text.body;\nconst from = message.from;\n\nconsole.log('✅ Processing message:', userText);\n\nreturn [{\n  json: {\n    userMessage: userText,\n    from: from,\n    skip: false\n  }\n}];"
      },
