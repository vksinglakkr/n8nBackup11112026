        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <div style=\"background: #ff8c00; padding: 20px; border-radius: 8px 8px 0 0;\">\n    <h2 style=\"color: white; margin: 0;\">International Gita Mahotsav 2025</h2>\n    <p style=\"color: #ffe0b2; margin: 4px 0 0;\">Gita Quiz - AI Feedback</p>\n  </div>\n  <div style=\"background: #fffaf0; padding: 24px; border: 1px solid #ffe0b2;\">\n    <p>Namaste <strong>{{ $('Gita Quiz Form').item.json.name }}</strong>,</p>\n    <p>Thank you for participating in the Gita Quiz. Here is your feedback:</p>\n    <div style=\"background: white; border-left: 4px solid #ff8c00; padding: 16px; margin: 16px 0; border-radius: 0 8px 8px 0;\">\n      <strong>Your Question:</strong><br/>\n      <em>{{ $('Gita Quiz Form').item.json.question }}</em>\n    </div>\n    <div style=\"background: white; border-left: 4px solid #4caf50; padding: 16px; margin: 16px 0; border-radius: 0 8px 8px 0;\">\n      <strong>AI Feedback:</strong><br/>\n      {{ $json.choices[0].message.content }}\n    </div>\n    <p style=\"color: #666; font-size: 13px;\">Keep studying the Gita! Every chapter brings new wisdom.</p>\n  </div>\n  <div style=\"background: #f5f5f5; padding: 12px; text-align: center; border-radius: 0 0 8px 8px;\">\n    <p style=\"color: #999; font-size: 12px; margin: 0;\">District Administration Kurukshetra | International Gita Mahotsav 2025</p>\n  </div>\n</div>",
