        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3-8b-8192\",\n  \"max_tokens\": 300,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a knowledgeable and encouraging Bhagavad Gita teacher. Give warm, constructive feedback on student quiz answers. Keep it to 3-4 lines. Mention one thing they got right and one thing to improve. End with a relevant Gita verse reference if possible.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Student Name: {{ $('Gita Quiz Form').item.json.name }}\\nChapter: {{ $('Gita Quiz Form').item.json.chapter }}\\nQuestion: {{ $('Gita Quiz Form').item.json.question }}\\nStudent Answer: {{ $('Gita Quiz Form').item.json.answer }}\\n\\nPlease provide brief, encouraging feedback on this answer.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "e5ff4aac-afc6-487e-a166-9d9b2627d615",
