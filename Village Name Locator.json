      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Village Result</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      background: #f0f4f8;\n      text-align: center;\n      padding: 60px 20px;\n    }\n    .card {\n      background: #fff;\n      padding: 40px 30px;\n      border-radius: 12px;\n      display: inline-block;\n      box-shadow: 0 10px 25px rgba(0,0,0,0.15);\n      min-width: 300px;\n    }\n    .card h2 {\n      margin-bottom: 25px;\n      color: #333;\n    }\n    .card p {\n      margin: 12px 0;\n      font-size: 16px;\n      line-height: 1.5;\n    }\n    .btn {\n      display: inline-block;\n      margin: 15px 10px 0 10px;\n      padding: 12px 25px;\n      background: #3A8DFF;\n      color: #fff;\n      text-decoration: none;\n      border-radius: 6px;\n      font-weight: bold;\n      transition: background 0.3s;\n    }\n    .btn:hover {\n      background: #0056cc;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <h2>Village Details</h2>\n    <p><strong>Village Name:</strong> {{$json[\"Village_Name\"]}}</p>\n    <p><strong>Latitude:</strong> {{$json[\"Latitude\"]}}</p>\n    <p><strong>Longitude:</strong> {{$json[\"Longitude\"]}}</p>\n    <div>\n      <a class=\"btn\" href=\"https://vksinglakkr.github.io/Village_Name_Finder/\">Search Another Village</a>\n      \n    </div>\n  </div>\n</body>\n</html>\n",
