    {
      "parameters": {
        "jsCode": "// Case 6 — build the prompt in code instead of an inline expression.\n// Demonstrates: input sanitising, a length guard, and assembling the\n// messages[] array by hand before it ever reaches the HTTP Request node.\n\nconst rawQuestion = $json.body.question || '';\nconst trimmedQuestion = rawQuestion.trim().slice(0, 500); // guard against oversized input\n\nconst systemPrompt =\n  \"You are a patient, well-read guide to the Bhagavad Gita. \" +\n  \"Ground every answer in a specific chapter and verse where possible. \" +\n  \"If the question falls outside the Gita's scope, say so plainly instead of guessing. \" +\n  \"Keep the answer under 150 words.\";\n\nconst messages = [\n  { role: 'system', content: systemPrompt },\n  { role: 'user', content: trimmedQuestion }\n];\n\nreturn [{\n  json: {\n    ...$json,\n    messages,\n    systemPrompt,\n    questionLength: trimmedQuestion.length\n  }\n}];"
      },
      "id": "7dc1eaa6-7bf7-4eb8-b82d-7b667639b66e",
      "name": "Build Prompt (Code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
